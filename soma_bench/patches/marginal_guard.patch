 LARGE_UPPER_CHARS = 53_300
 LARGE_CAP_CHARS = 24_000
 
+# Marginal-rewrite guard (bench-proposed, 2026-09-25). A rewrite is committed
+# only when it saves at least MIN_RELATIVE_SAVINGS of the input text. Live-
+# accounting evidence: 34% of rewrites kept >=95% of input (worst: 232,346 ->
+# 232,316 chars); 20% saved <1% of input (0.5% of total value). Each committed
+# rewrite invalidates the prompt-cache prefix from that message onward, so a
+# 30-char saving converts ~58K cached tokens (0.1x) to fresh (1.0x) — a loss
+# under any session timing. Guard projection: skips 24% of rewrites, forfeits
+# 1.0% of est-token value. Skipped rewrites leave the message byte-identical
+# (cache prefix preserved, same as passthrough).
+# 0.0 = disabled (live-plugin behavior).
+MIN_RELATIVE_SAVINGS = 0.02
+
+# Accounting reasons are distinct so guarded vs unguarded runs read cleanly:
+#   near_passthrough  - rewrite committed (live behavior)
+#   marginal_skipped  - extraction produced <MIN_RELATIVE_SAVINGS; NOT committed
+MARGINAL_SKIP_REASON = "marginal_skipped"
+
 
 # -- Task 4: overflow gate + minimal fallback --------------------------------
 # should_compress() only fires on provider-PROVEN overflow: the provider's own
